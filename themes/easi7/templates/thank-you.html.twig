{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="page-hero" style="text-align:center;border-bottom:none;padding:110px 0;">
  <div class="wrap">
    <span class="eyebrow" style="justify-content:center;">Message received</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.tagline %}<p class="lede" style="margin-left:auto;margin-right:auto;">{{ page.header.tagline }}</p>{% endif %}
    {{ page.content|raw }}
    <div class="hero-ctas" style="justify-content:center;margin-top:1.6em;">
      <a class="btn brass" href="{{ url('/') }}">Back to home</a>
      <a class="btn ghost" href="{{ url('/case-studies') }}">Browse case studies</a>
    </div>
  </div>
</section>
<script>
(function () {
  var params = new URLSearchParams(window.location.search);
  if (![...params.keys()].length) return;
  var trackedKeys = ['lead_id', 'service', 'subservice', 'form_location', 'source_page',
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];
  var payload = { event: 'lead_submitted' };
  trackedKeys.forEach(function (key) {
    var value = params.get(key);
    if (value) payload[key] = value;
  });
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push(payload);
  if (window.history && window.history.replaceState) {
    window.history.replaceState({}, document.title, window.location.pathname);
  }
})();
</script>
{% endblock %}
