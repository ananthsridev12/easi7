{#
  Design A: Problem -> Solution -> Proof
  Best suited to services where the buyer is problem-aware.
  Expects (frontmatter): eyebrow, headline, summary, problem, solution, solution_answer,
  approach, capabilities[{title,items[],related_label,related_url}], deliverables[{a,b}],
  process[{title,body}], comparison{headers,rows[{a,b}],note}, tools[], outcomes[],
  who_needs_this[{title,body,items[]}], faqs[{q,a}] (5+), cta, primary_intent, entities[]
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ page.header.eyebrow ?? 'Service' }}</span>
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.tagline %}<p class="lede">{{ page.header.tagline }}</p>{% endif %}
  </div>
</section>

{% set sc = 0 %}

{% if page.header.problem %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">The challenge</span>
    <h2>{{ page.header.problem_heading ?? 'Where this usually breaks down' }}</h2>
    <div>{{ page.header.problem|raw }}</div>
  </div>
</section>
{% endif %}

{% if page.header.solution %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">What we fix</span>
    <h2>{{ page.header.solution_heading ?? 'What this service actually solves' }}</h2>
    <div>{{ page.header.solution|raw }}</div>
  </div>
</section>
{% endif %}

{% if page.header.approach %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Our approach</span>
    <h2>How we run it</h2>
    <div>{{ page.header.approach|raw }}</div>
  </div>
</section>
{% endif %}

{% if page.header.capabilities %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">What's included</span>
    <h2>Capabilities &amp; deliverables</h2>
    {% include 'partials/framework-grid.html.twig' with { items: page.header.capabilities } %}
  </div>
</section>
{% endif %}

{% if page.header.process %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Process</span>
    <h2>How an engagement runs</h2>
    <div class="process-line"></div>
    <div class="process">
      {% for step in page.header.process %}
      <div class="step"><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.tools %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Tools &amp; technologies</span>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:1em;">
      {% for t in page.header.tools %}<span class="tag">{{ t }}</span>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.who_needs_this %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Who this is for</span>
    <h2>Who needs this</h2>
    {% include 'partials/persona-grid.html.twig' with { items: page.header.who_needs_this } %}
  </div>
</section>
{% endif %}

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Proof</span>
    <h2>Related work</h2>
    {% include 'partials/related-work.html.twig' with { page: page } %}
  </div>
</section>

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Ways of working</span>
    <h2>How to engage us for this</h2>
    {% include 'partials/engagement-models.html.twig' %}
  </div>
</section>

{% if page.header.faqs %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">FAQs</span>
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}

{% include 'partials/ai-reference.html.twig' with {
  page: page,
  answer: page.header.solution_answer ?? null,
  deliverables: page.header.deliverables ?? null,
  comparison: page.header.comparison ?? null,
  outcomes: page.header.outcomes ?? null
} %}
{% include 'partials/service-schema.html.twig' with { page: page } %}
{% include 'partials/page-metadata.html.twig' with { page: page } %}
{% endblock %}
