{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Case Studies</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.tagline %}<p class="lede">{{ page.header.tagline }}</p>{% endif %}
  </div>
</section>

<section class="block" style="border-bottom:none;">
  <div class="wrap with-sidebar">
    <div>
      <div class="cs-grid">
        {% for item in page.collection() %}
          {% include 'partials/cards/case-study-card.html.twig' with { item: item } %}
        {% endfor %}
      </div>
    </div>
    {% include 'partials/sidebar.html.twig' with {
      links_title: 'Explore',
      links: [
        { label: 'Portfolio', url: '/portfolio' },
        { label: 'Services', url: '/services' },
        { label: 'Industries', url: '/industries' }
      ],
      cta: {
        heading: 'Want results like these?',
        body: "We'll tell you what's realistic for your stack and budget before we start.",
        button_label: 'Start a conversation',
        button_url: '/contact'
      }
    } %}
  </div>
</section>

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}
{% endblock %}

{% block stylesheets %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ (page.url(true) ~ '#collection')|json_encode(64)|raw }},
  "name": {{ page.title|json_encode(64)|raw }},
  "url": {{ page.url(true)|json_encode(64)|raw }},
  "isPartOf": { "@id": {{ (url('/', true) ~ '#website')|json_encode(64)|raw }} },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {% for item in page.collection() %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": {{ item.url(true)|json_encode(64)|raw }},
        "name": {{ item.title|json_encode(64)|raw }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>
{% endblock %}
