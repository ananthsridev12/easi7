{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ page.header.eyebrow ?? 'Services' }}</span>
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
    {% if page.route == '/services' %}
    <div class="hero-ctas">
      <a class="btn ghost" href="{{ url('/tech-stack') }}">See our full tool stack &rarr;</a>
    </div>
    {% endif %}
  </div>
</section>

{% if page.content|trim %}
<section class="block">
  <div class="wrap">
    {{ page.content|raw }}
  </div>
</section>
{% endif %}

<section class="block" style="border-bottom:none;">
  <div class="wrap" style="padding:0;">
    <div class="card-grid">
      {% for item in page.collection() %}
        {% include 'partials/cards/service-card.html.twig' with { item: item } %}
      {% endfor %}
    </div>
  </div>
</section>

{% if page.header.industries %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Relevant industries</span>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:1em;">
      {% for ind in page.header.industries %}<a class="tag" href="{{ url(ind.url) }}">{{ ind.label }}</a>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.related_services %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Related services</span>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:1em;">
      {% for rs in page.header.related_services %}<a class="tag" href="{{ url(rs.url) }}">{{ rs.label }}</a>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.faqs %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">FAQs</span>
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}
{% endblock %}
