{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ page.header.eyebrow ?? 'Services' }}</span>
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
    {% if page.route == '/services' %}
    <div class="hero-ctas">
      <a class="btn ghost" href="{{ url('/tech-stack') }}">See our full tool stack &rarr;</a>
    </div>
    {% endif %}
  </div>
</section>

{% set sc = 0 %}

{% if page.content|trim %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    {{ page.content|raw }}
    {% if page.header.overview_answer %}
    <div class="answer-box">
      <span class="answer-label">In simple terms</span>
      <p>{{ page.header.overview_answer }}</p>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if page.header.methodology %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Methodology</span>
    <h2>How we approach {{ page.title }}</h2>
    <div class="process-line"></div>
    <div class="process">
      {% for step in page.header.methodology %}
      <div class="step"><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}" style="border-bottom:none;">
  <div class="wrap">
    <span class="eyebrow">Services in this category</span>
    <h2>{{ page.header.services_heading ?? ('Every ' ~ page.title ~ ' service, broken down') }}</h2>
    <div class="card-grid" style="margin-top:1.5em;">
      {% for item in page.collection() %}
        {% include 'partials/cards/service-card.html.twig' with { item: item } %}
      {% endfor %}
    </div>
  </div>
</section>

{% if page.header.industries %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Relevant industries</span>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:1em;">
      {% for ind in page.header.industries %}<a class="tag" href="{{ url(ind.url) }}">{{ ind.label }}</a>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.related_services %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Related services</span>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:1em;">
      {% for rs in page.header.related_services %}<a class="tag" href="{{ url(rs.url) }}">{{ rs.label }}</a>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.faqs %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">FAQs</span>
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}

{% include 'partials/page-metadata.html.twig' with { page: page } %}
{% endblock %}
