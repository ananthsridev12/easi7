{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Portfolio</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.tagline %}<p class="lede">{{ page.header.tagline }}</p>{% endif %}
  </div>
</section>

<section class="block" style="border-bottom:none;">
  <div class="wrap with-sidebar">
    <div>
      <div class="pf-grid">
        {% for item in page.collection() %}
          {% include 'partials/cards/case-study-card.html.twig' with { item: item } %}
        {% endfor %}
      </div>
    </div>
    {% include 'partials/sidebar.html.twig' with {
      links_title: 'Explore',
      links: [
        { label: 'Case Studies', url: '/case-studies' },
        { label: 'Services', url: '/services' },
        { label: 'Industries', url: '/industries' }
      ],
      cta: {
        heading: 'Ready for similar results?',
        body: "Tell us what's not working and we'll tell you honestly whether we can fix it.",
        button_label: 'Start a project',
        button_url: '/contact'
      }
    } %}
  </div>
</section>

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}
{% endblock %}
