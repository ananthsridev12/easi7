{#
  Design B: Service / Capability-led
  Best suited to clearly defined implementation services.
  Expects (frontmatter): eyebrow, headline, summary, overview, capabilities[], included[],
  how_we_work[{title,body}], use_cases[], benefits[], why_choose_us[], faqs[{q,a}], cta
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ page.header.eyebrow ?? 'Service' }}</span>
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
    <div class="hero-ctas">
      <a class="btn brass" href="{{ url('/contact') }}">Talk to us about this &rarr;</a>
    </div>
  </div>
</section>

{% if page.header.overview %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Overview</span>
    <div>{{ page.header.overview|raw }}</div>
  </div>
</section>
{% endif %}

{% if page.header.capabilities %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Capabilities</span>
    <h2>What we bring to this</h2>
    <ul>
      {% for c in page.header.capabilities %}<li>{{ c }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.included %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">What's included</span>
    <h2>Scope of work</h2>
    <ul>
      {% for i in page.header.included %}<li>{{ i }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.how_we_work %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">How we work</span>
    <h2>The engagement, step by step</h2>
    <div class="process-line"></div>
    <div class="process">
      {% for step in page.header.how_we_work %}
      <div class="step"><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.use_cases %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Use cases</span>
    <h2>Where this fits</h2>
    <ul>
      {% for u in page.header.use_cases %}<li>{{ u }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.benefits %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Benefits</span>
    <h2>What changes for you</h2>
    <ul>
      {% for b in page.header.benefits %}<li>{{ b }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.why_choose_us %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">Why us</span>
    <h2>Why work with EASI7 on this</h2>
    <ul>
      {% for w in page.header.why_choose_us %}<li>{{ w }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<section class="block">
  <div class="wrap">
    <span class="eyebrow">Related services</span>
    <h2>Other services in this area</h2>
    {% include 'partials/related-services.html.twig' with { page: page } %}
  </div>
</section>

{% if page.header.faqs %}
<section class="block">
  <div class="wrap">
    <span class="eyebrow">FAQs</span>
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}
{% endblock %}
