{#
  Design B: Service / Capability-led
  Best suited to clearly defined implementation services.
  Expects (frontmatter): eyebrow, headline, summary, overview, overview_answer,
  capabilities[{title,items[],related_label,related_url}], included[{a,b}],
  how_we_work[{title,body}], comparison{headers,rows[{a,b}],note}, use_cases[],
  who_needs_this[{title,body,items[]}], benefits[], why_choose_us[],
  faqs[{q,a}] (5+), cta, primary_intent, entities[]
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ page.header.eyebrow ?? 'Service' }}</span>
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.tagline %}<p class="lede">{{ page.header.tagline }}</p>{% endif %}
  </div>
</section>

{% set sc = 0 %}

{% if page.header.overview %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Overview</span>
    <div>{{ page.header.overview|raw }}</div>
  </div>
</section>
{% endif %}

{% if page.header.capabilities %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Capabilities</span>
    <h2>What we bring to this</h2>
    {% include 'partials/framework-grid.html.twig' with { items: page.header.capabilities } %}
  </div>
</section>
{% endif %}

{% if page.header.how_we_work %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">How we work</span>
    <h2>The engagement, step by step</h2>
    <div class="process-line"></div>
    <div class="process">
      {% for step in page.header.how_we_work %}
      <div class="step"><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.who_needs_this %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Who this is for</span>
    <h2>Who needs this</h2>
    {% include 'partials/persona-grid.html.twig' with { items: page.header.who_needs_this } %}
  </div>
</section>
{% endif %}

{% if page.header.benefits %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Benefits</span>
    <h2>What changes for you</h2>
    <ul>
      {% for b in page.header.benefits %}<li>{{ b }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.why_choose_us %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Why us</span>
    <h2>Why work with EASI7 on this</h2>
    <ul>
      {% for w in page.header.why_choose_us %}<li>{{ w }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Related services</span>
    <h2>Other services in this area</h2>
    {% include 'partials/related-services.html.twig' with { page: page } %}
  </div>
</section>

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Ways of working</span>
    <h2>How to engage us for this</h2>
    {% include 'partials/engagement-models.html.twig' %}
  </div>
</section>

{% if page.header.faqs %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">FAQs</span>
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}

{% include 'partials/ai-reference.html.twig' with {
  page: page,
  answer: page.header.overview_answer ?? null,
  deliverables: page.header.included ?? null,
  comparison: page.header.comparison ?? null,
  use_cases: page.header.use_cases ?? null
} %}
{% include 'partials/service-schema.html.twig' with { page: page } %}
{% include 'partials/page-metadata.html.twig' with { page: page } %}
{% endblock %}
