{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Blog</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.tagline %}<p class="lede">{{ page.header.tagline }}</p>{% endif %}
  </div>
</section>

<section class="block" style="border-bottom:none;">
  <div class="wrap with-sidebar">
    <div>
      <div class="blog-grid">
        {% for item in page.collection() %}
          {% set cat = (item.taxonomy.category is defined ? item.taxonomy.category|first : null)|default('Strategy') %}
          {% set item_date = item.date ? item.date|date('M Y') : '' %}
          {% include 'partials/cards/kb-card.html.twig' with { item: item, kind: 'Article', meta: cat ~ ' · ' ~ item_date } %}
        {% endfor %}
      </div>
    </div>
    {% include 'partials/sidebar.html.twig' with {
      links_title: 'Explore',
      links: [
        { label: 'Knowledge Hub', url: '/knowledge-hub' },
        { label: 'Case Studies', url: '/case-studies' },
        { label: 'Tools We Use', url: '/tech-stack' },
        { label: 'About EASI7', url: '/about' }
      ],
      recent_title: 'Recent Posts',
      recent: page.collection()|slice(0, 5),
      cta: {
        heading: 'Have a project in mind?',
        body: "Tell us what's not working - we'll tell you honestly if we can help.",
        button_label: 'Start a conversation',
        button_url: '/contact'
      }
    } %}
  </div>
</section>
{% endblock %}

{% block stylesheets %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ (page.url(true) ~ '#collection')|json_encode(64)|raw }},
  "name": {{ page.title|json_encode(64)|raw }},
  "url": {{ page.url(true)|json_encode(64)|raw }},
  "isPartOf": { "@id": {{ (url('/', true) ~ '#website')|json_encode(64)|raw }} },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {% for item in page.collection() %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": {{ item.url(true)|json_encode(64)|raw }},
        "name": {{ item.title|json_encode(64)|raw }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>
{% endblock %}
