{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Blog</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
  </div>
</section>

<section class="block" style="border-bottom:none;">
  <div class="wrap">
    <div class="blog-grid">
      {% for item in page.collection() %}
        {% set cat = (item.taxonomy.category is defined ? item.taxonomy.category|first : null)|default('Strategy') %}
        {% set item_date = item.date ? item.date|date('M Y') : '' %}
        {% include 'partials/cards/kb-card.html.twig' with { item: item, kind: 'Article', meta: cat ~ ' · ' ~ item_date } %}
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
