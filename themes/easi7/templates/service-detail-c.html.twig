{#
  Design C: Authority / Framework-led
  Best suited to strategic, technical, analytical, or emerging services.
  Expects (frontmatter): eyebrow, headline, summary, definition, definition_answer,
  why_it_matters, diagram, framework[{title,items[],related_label,related_url}],
  deliverables[{a,b}], methodology[{title,body}], comparison{headers,rows[{a,b}],note},
  who_needs_this[{title,body,items[]}], faqs[{q,a}] (5+), cta, primary_intent, entities[]
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ page.header.eyebrow ?? 'Service' }}</span>
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
    <div class="hero-ctas">
      <a class="btn brass" href="{{ url('/contact') }}">Talk to us about this &rarr;</a>
    </div>
  </div>
</section>

{% set sc = 0 %}

{% if page.header.definition %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">What it is</span>
    <h2>{{ page.header.definition_heading ?? ('What is ' ~ page.title ~ '?') }}</h2>
    <div>{{ page.header.definition|raw }}</div>
    {% if page.header.definition_answer %}
    <div class="answer-box">
      <span class="answer-label">In simple terms</span>
      <p>{{ page.header.definition_answer }}</p>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if page.header.why_it_matters %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Why it matters</span>
    <h2>{{ page.header.why_it_matters_heading ?? 'Why this matters for the business' }}</h2>
    <div>{{ page.header.why_it_matters|raw }}</div>
    {% if page.header.diagram %}
    <div class="diagram"><pre>{{ page.header.diagram }}</pre></div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if page.header.challenges %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">The landscape</span>
    <h2>What makes this hard to get right</h2>
    <ul>
      {% for c in page.header.challenges %}<li>{{ c }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.framework %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Our framework</span>
    <h2>{{ page.header.framework_heading ?? ('How we approach ' ~ page.title) }}</h2>
    {% include 'partials/framework-grid.html.twig' with { items: page.header.framework } %}
  </div>
</section>
{% endif %}

{% if page.header.deliverables %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">What we deliver</span>
    <h2>Scope, area by area</h2>
    {% include 'partials/data-table.html.twig' with { headers: ['Area', 'What we deliver'], rows: page.header.deliverables } %}
  </div>
</section>
{% endif %}

{% if page.header.methodology %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Methodology</span>
    <h2>How it actually runs</h2>
    <div class="process-line"></div>
    <div class="process">
      {% for step in page.header.methodology %}
      <div class="step"><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.comparison %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">In context</span>
    <h2>{{ page.header.comparison.heading ?? 'How this compares' }}</h2>
    {% include 'partials/data-table.html.twig' with { headers: page.header.comparison.headers, rows: page.header.comparison.rows, note: page.header.comparison.note ?? null } %}
  </div>
</section>
{% endif %}

{% if page.header.key_metrics %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Evaluation criteria</span>
    <h2>What we measure this against</h2>
    <ul>
      {% for k in page.header.key_metrics %}<li>{{ k }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.who_needs_this %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Who this is for</span>
    <h2>Who needs this</h2>
    {% include 'partials/persona-grid.html.twig' with { items: page.header.who_needs_this } %}
  </div>
</section>
{% endif %}

{% if page.header.use_cases %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Use cases</span>
    <h2>Where this applies</h2>
    <ul>
      {% for u in page.header.use_cases %}<li>{{ u }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if page.header.expert_insight %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">A closer look</span>
    <blockquote>{{ page.header.expert_insight }}</blockquote>
  </div>
</section>
{% endif %}

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">Related services</span>
    <h2>Other services in this area</h2>
    {% include 'partials/related-services.html.twig' with { page: page } %}
  </div>
</section>

{% if page.header.faqs %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <span class="eyebrow">FAQs</span>
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}

{% include 'partials/page-metadata.html.twig' with { page: page } %}
{% endblock %}
