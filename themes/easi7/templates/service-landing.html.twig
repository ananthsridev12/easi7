{#
  Commercial service landing page (agency-style, not an explainer article).
  Expects (frontmatter): eyebrow, headline, tagline, hero_cta{primary_label,primary_url,secondary_label,secondary_url},
  definition_answer (1-2 sentence quick answer, shown near the top for AEO extraction),
  definition (2-3 short <p> paragraphs: what it is / why it matters / how it differs),
  problems[{title,body}] (4-6 cards), included[{title,body}] (4-6 cards),
  methodology[{title,body}] (process steps), before_after{headers,rows[{a,b}]},
  results[{label,desc}] (metric categories - no invented numbers), proof_case_study{stat,label,url},
  tools_used[] (flat strings, shown as tags), industries[{label,url}], who_for[] (flat strings, shown as tags),
  why_us[{title,body}], ai_relationships{diagram, items[{title,body,url}]},
  faqs[{q,a}], cta (closing stats+form panel - same as every other template),
  Routed to the Reference zone above the footer (unchanged): deliverables, comparison, key_metrics, use_cases
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}

<section class="page-hero">
  <div class="wrap">
    <h1>{{ page.header.headline ?? page.title }}</h1>
    {% if page.header.tagline %}<p class="lede">{{ page.header.tagline }}</p>{% endif %}
    {% if page.header.hero_cta %}
    <div class="hero-ctas">
      <a class="btn brass" href="{{ url(page.header.hero_cta.primary_url ?? '/contact') }}">{{ page.header.hero_cta.primary_label ?? 'Get a quote' }}</a>
      <a class="btn ghost" href="{{ url(page.header.hero_cta.secondary_url ?? '/contact') }}">{{ page.header.hero_cta.secondary_label ?? 'Talk to an expert' }}</a>
    </div>
    {% endif %}
  </div>
</section>

{% set sc = 0 %}

{% if page.header.definition_answer %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <div class="answer-box">
      <span class="answer-label">Quick answer</span>
      <p>{{ page.header.definition_answer }}</p>
    </div>
  </div>
</section>
{% endif %}

{% if page.header.definition %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>What is {{ page.title }}?</h2>
    <div>{{ page.header.definition|raw }}</div>
  </div>
</section>
{% endif %}

{% if page.header.problems %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Common problems we solve</h2>
    {% include 'partials/persona-grid.html.twig' with { items: page.header.problems } %}
  </div>
</section>
{% endif %}

{% if page.header.included %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Everything covered in this service</h2>
    {% include 'partials/persona-grid.html.twig' with { items: page.header.included } %}
  </div>
</section>
{% endif %}

{% if page.header.methodology %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Our optimization framework</h2>
    <div class="process-line"></div>
    <div class="process">
      {% for step in page.header.methodology %}
      <div class="step"><h3>{{ step.title }}</h3><p>{{ step.body }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if page.header.before_after %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>What actually changes</h2>
    {% include 'partials/data-table.html.twig' with { headers: page.header.before_after.headers ?? ['Before', 'After'], rows: page.header.before_after.rows } %}
  </div>
</section>
{% endif %}

{% if page.header.results or page.header.proof_case_study %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>What we report on</h2>
    {% if page.header.results %}
    <div class="persona-grid">
      {% for r in page.header.results %}
      <div class="persona-card"><h3>{{ r.label }}</h3><p>{{ r.desc }}</p></div>
      {% endfor %}
    </div>
    {% endif %}
    {% if page.header.proof_case_study %}
    <div class="answer-box" style="margin-top:1.2em;">
      <span class="answer-label">Real results</span>
      <p>{{ page.header.proof_case_study.stat }} <a href="{{ url(page.header.proof_case_study.url) }}">{{ page.header.proof_case_study.label }} &rarr;</a></p>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if page.header.tools_used %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Tools &amp; platforms</h2>
    {% include 'partials/icon-items.html.twig' with { items: page.header.tools_used, layout: 'grid-3' } %}
  </div>
</section>
{% endif %}

{% if page.header.industries or page.header.who_for %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    {% if page.header.industries %}
    <h2>Industries we optimize for</h2>
    {% include 'partials/icon-items.html.twig' with { items: page.header.industries, layout: 'grid-2' } %}
    {% endif %}
    {% if page.header.who_for %}
    <h2 style="margin-top:{{ page.header.industries ? '1.8em' : '0' }};">Built for teams like yours</h2>
    {% include 'partials/icon-items.html.twig' with { items: page.header.who_for, layout: 'list' } %}
    {% endif %}
  </div>
</section>
{% endif %}

{% if page.header.why_us %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Why choose EASI7</h2>
    {% include 'partials/persona-grid.html.twig' with { items: page.header.why_us } %}
    {% if page.header.expert_insight %}<blockquote style="margin-top:1.4em;">{{ page.header.expert_insight }}</blockquote>{% endif %}
  </div>
</section>
{% endif %}

{% if page.header.ai_relationships %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>How {{ page.title }} connects with AI search</h2>
    {% if page.header.ai_relationships.diagram %}
    <div class="diagram"><pre>{{ page.header.ai_relationships.diagram }}</pre></div>
    {% endif %}
    {% if page.header.ai_relationships.items %}
    {% include 'partials/persona-grid.html.twig' with { items: page.header.ai_relationships.items } %}
    {% endif %}
  </div>
</section>
{% endif %}

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Related SEO services</h2>
    {% include 'partials/related-services.html.twig' with { page: page } %}
  </div>
</section>

{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>How to engage us for this</h2>
    {% include 'partials/engagement-models.html.twig' %}
  </div>
</section>

{% if page.header.faqs %}
{% set sc = sc + 1 %}
<section class="block {{ cycle(['', 'alt'], sc) }}">
  <div class="wrap">
    <h2>Common questions</h2>
    {% include 'partials/faq.html.twig' with { faqs: page.header.faqs } %}
  </div>
</section>
{% endif %}

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}

{% include 'partials/ai-reference.html.twig' with {
  page: page,
  deliverables: page.header.deliverables ?? null,
  comparison: page.header.comparison ?? null,
  key_metrics: page.header.key_metrics ?? null,
  use_cases: page.header.use_cases ?? null
} %}
{% include 'partials/service-schema.html.twig' with { page: page } %}
{% include 'partials/page-metadata.html.twig' with { page: page } %}
{% endblock %}
