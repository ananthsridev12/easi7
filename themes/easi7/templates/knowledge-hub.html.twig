{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Knowledge Hub</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
  </div>
</section>

{% if page.header.guides %}
<section class="block">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">Guides</span>
        <h2>In-depth playbooks from the blog</h2>
      </div>
      <a class="btn ghost" href="{{ url('/blog') }}">All articles</a>
    </div>
    <div class="kb-grid">
      {% for res in page.header.guides %}
        {% set item = page.find(res.route) %}
        {% if item %}{% include 'partials/cards/kb-card.html.twig' with { item: item, kind: 'Guide', meta: res.meta } %}{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="block" style="border-bottom:none;">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">Glossary</span>
        <h2>Marketing &amp; analytics terms, explained plainly</h2>
      </div>
    </div>
    <div class="glossary-list">
      {% for item in page.collection() %}
      <a class="glossary-item" href="{{ item.url }}">
        <h3>{{ item.title }}</h3>
        <span class="arrow">&rarr;</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
