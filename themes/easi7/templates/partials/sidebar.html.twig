{#
  Expects (all optional): links (array of {label, url}), links_title (string),
  recent (array of Page objects), recent_title (string), cta ({heading, body, button_label, button_url})
#}
<aside class="page-sidebar">
  {% if links is defined and links|length %}
  <div class="sidebar-block">
    <h4>{{ links_title ?? 'Explore' }}</h4>
    <ul>
      {% for l in links %}<li><a href="{{ url(l.url) }}">{{ l.label }}</a></li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if recent is defined and recent|length %}
  <div class="sidebar-block">
    <h4>{{ recent_title ?? 'Recent' }}</h4>
    <ul>
      {% for item in recent %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if cta is defined and cta %}
  <div class="sidebar-cta">
    <h4>{{ cta.heading }}</h4>
    <p>{{ cta.body }}</p>
    <a class="btn brass small" href="{{ url(cta.button_url) }}">{{ cta.button_label }}</a>
  </div>
  {% endif %}
</aside>
