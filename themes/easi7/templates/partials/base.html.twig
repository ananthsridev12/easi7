{% set theme = config.themes.easi7 %}
{% set appearance = theme.appearance ?? {} %}
{% set seo = theme.seo ?? {} %}
{% set analytics = theme.analytics ?? {} %}
{% set icons = theme.icons ?? {} %}
{% set accent = appearance.accent_color ?? '#2454E0' %}
{% set description = (page.header.metadata.description ?? seo.default_description ?? config.site.metadata.description)|e %}
{% set og_image = page.header.metadata.og_image ?? seo.default_og_image ?? '' %}
{% set title_sep = seo.title_separator ?? '·' %}
<!DOCTYPE html>
<html lang="en"{% if appearance.theme_mode in ['light', 'dark'] %} data-theme="{{ appearance.theme_mode }}"{% endif %}>
<head>
{% block head %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{% if page.route == '/' %}{{ page.title ?? config.site.title }}{% elseif page.title %}{{ page.title }} {{ title_sep }} {{ config.site.title }}{% else %}{{ config.site.title }}{% endif %}{% endblock %}</title>
  <meta name="description" content="{{ description }}">
  {% if seo.robots_index is same as(false) or page.header.metadata.robots == 'noindex' %}<meta name="robots" content="noindex,nofollow">{% endif %}
  {% if seo.google_site_verification %}<meta name="google-site-verification" content="{{ seo.google_site_verification }}">{% endif %}
  <link rel="canonical" href="{{ page.url(true) }}">
  <link rel="icon" type="image/svg+xml" href="{{ url('theme://images/favicon.svg') }}">
  <meta property="og:title" content="{{ page.title ?? config.site.title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.url(true) }}">
  {% if og_image %}<meta property="og:image" content="{{ og_image starts with 'http' ? og_image : url(og_image, true) }}">{% endif %}
  <meta name="twitter:card" content="{{ og_image ? 'summary_large_image' : 'summary' }}">
  {% if seo.twitter_handle %}<meta name="twitter:site" content="{{ seo.twitter_handle }}">{% endif %}
  {% if seo.organization_schema is not same as(false) %}
  {% set social_urls = [] %}
  {% for social in (theme.socials ?? []) %}{% set social_urls = social_urls|merge([social.url]) %}{% endfor %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ (theme.company.legal_name ?? theme.company.name ?? config.site.title)|json_encode(64)|raw }},
    "url": {{ url('/', true)|json_encode(64)|raw }},
    "email": {{ (theme.company.email ?? '')|json_encode(64)|raw }},
    "telephone": {{ (theme.company.phone ?? '')|json_encode(64)|raw }}{% if social_urls|length %},
    "sameAs": {{ social_urls|json_encode(64)|raw }}{% endif %}
  }
  </script>
  {% endif %}
  <link rel="stylesheet" href="{{ config.themes.easi7.google_fonts_url }}">
  {% if icons.fontawesome_enabled %}
    {% if icons.fontawesome_local %}
    <link rel="stylesheet" href="{{ url('theme://css/fontawesome/all.min.css') }}">
    {% else %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css">
    {% endif %}
  {% endif %}
  <link rel="stylesheet" href="{{ url('theme://css/easi7.css') }}">
  <style>
    :root{
      --brass: {{ accent }};
      --brass-ink: color-mix(in srgb, {{ accent }} 80%, black);
      --brass-on-dark: color-mix(in srgb, {{ accent }} 65%, white);
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]){
        --brass: color-mix(in srgb, {{ accent }} 72%, white);
        --brass-ink: color-mix(in srgb, {{ accent }} 85%, white);
        --brass-on-dark: color-mix(in srgb, {{ accent }} 65%, white);
      }
    }
    :root[data-theme="dark"]{
      --brass: color-mix(in srgb, {{ accent }} 72%, white);
      --brass-ink: color-mix(in srgb, {{ accent }} 85%, white);
      --brass-on-dark: color-mix(in srgb, {{ accent }} 65%, white);
    }
  </style>
  {% if analytics.gtm_id %}
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ analytics.gtm_id }}');</script>
  {% elseif analytics.ga4_id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.ga4_id }}"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ analytics.ga4_id }}');</script>
  {% endif %}
  {% block stylesheets %}{% endblock %}
{% endblock %}
</head>
<body class="{% if appearance.header_fixed is same as(false) %}header-static {% endif %}{% if appearance.header_transparent and page.route == '/' %}header-transparent {% endif %}{% if appearance.footer_sticky %}footer-sticky{% endif %}">
  {% if analytics.gtm_id %}
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ analytics.gtm_id }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  {% endif %}
  <a class="skip-link" href="#main">Skip to content</a>
  {% include 'partials/header.html.twig' %}
  <main id="main">
    {% block content %}{% endblock %}
  </main>
  {% include 'partials/footer.html.twig' %}
  <script src="{{ url('theme://js/easi7.js') }}" defer></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
