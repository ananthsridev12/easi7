{# Expects: faqs (array of {q, a}) #}
{% if faqs is defined and faqs|length %}
<div class="accordion">
  {% for item in faqs %}
  <div class="accordion-item" data-open="false">
    <button class="accordion-trigger" type="button" aria-expanded="false">
      <span>{{ item.q }}</span>
      <span class="plus">+</span>
    </button>
    <div class="accordion-panel">
      <p>{{ item.a }}</p>
    </div>
  </div>
  {% endfor %}
</div>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in faqs %}{"@type":"Question","name":{{ item.q|json_encode(64)|raw }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a|json_encode(64)|raw }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
