{#
  Expects: heading, body, button_label, button_url
  Closing stats + lead-capture split panel - reused verbatim on every page (home, services, apps, case studies, etc.)
#}
{% set proof = config.themes.easi7.proof_stats ?? [] %}
{% set page_service = page.header.taxonomy.service[0] ?? null %}
{% set parent_service = (page.parent and page.parent.header.taxonomy.service is defined) ? (page.parent.header.taxonomy.service[0] ?? null) : null %}
{% if parent_service %}
  {% set cta_service = parent_service %}
  {% set cta_subservice = page_service %}
{% else %}
  {% set cta_service = page_service %}
  {% set cta_subservice = null %}
{% endif %}
<section class="block cta-band">
  <div class="wrap cta-split">
    <div class="cta-stats-panel">
      <span class="eyebrow" style="color:var(--brass-on-dark);">Get in touch</span>
      <h2>{{ heading }}</h2>
      <p>{{ body }}</p>
      {% if proof|length %}
      <div class="cta-stats-row">
        {% for s in proof %}
        <div class="cta-stat">
          <span class="num mono" data-count-to="{{ s.value }}" data-count-suffix="{{ s.suffix }}">0{{ s.suffix }}</span>
          <span class="lbl">{{ s.label }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <div class="socials" style="margin-top:26px;">
        {% for social in config.themes.easi7.socials %}
          <a href="{{ social.url }}" rel="noopener" target="_blank">{{ social.label }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="cta-form-panel">
      <h3>Ready to get started?</h3>
      <p class="cta-form-note">We usually reply within 24 hours.</p>
      <form action="/submit-form.php" method="POST">
        <input type="hidden" name="page" value="{{ page.url() }}">
        <input type="hidden" name="form_location" value="closing_cta_panel">
        {% if cta_service %}<input type="hidden" name="service" value="{{ cta_service }}">{% endif %}
        {% if cta_subservice %}<input type="hidden" name="subservice" value="{{ cta_subservice }}">{% endif %}
        <input type="hidden" name="utm_source" value=""><input type="hidden" name="utm_medium" value="">
        <input type="hidden" name="utm_campaign" value=""><input type="hidden" name="utm_term" value="">
        <input type="hidden" name="utm_content" value=""><input type="hidden" name="gclid" value="">
        <input type="hidden" name="fbclid" value="">
        <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
        <label>Name<input type="text" name="name" placeholder="Jane Doe" required></label>
        <label>Email<input type="email" name="email" placeholder="jane@company.com" required></label>
        <label>Message<textarea name="message" rows="3" placeholder="What are you working on?" required></textarea></label>
        <button class="btn brass" type="submit">{{ button_label ?? 'Send message' }} &rarr;</button>
      </form>
      <p class="cta-form-consent">We only use this to reply to you - no spam, unsubscribe any time.</p>
    </div>
  </div>
</section>
