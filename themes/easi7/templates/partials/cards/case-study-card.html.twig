{#
  Expects: item (a Grav Page with header.client / header.industry / header.summary / header.metrics)
#}
<a class="cs-card" href="{{ item.url }}">
  <div class="cs-top">
    <span class="cs-client">{{ item.header.client ?? item.title }}</span>
    {% if item.header.industry %}<span class="tag">{{ item.header.industry }}</span>{% endif %}
  </div>
  {% if item.header.summary %}<p>{{ item.header.summary }}</p>{% endif %}
  {% if item.header.metrics %}
  <div class="cs-metrics">
    {% for m in item.header.metrics %}
    <div class="cs-metric"><span class="v mono">{{ m.value }}</span><span class="k">{{ m.label }}</span></div>
    {% endfor %}
  </div>
  {% endif %}
  <span class="cs-link">Read more &rarr;</span>
</a>
