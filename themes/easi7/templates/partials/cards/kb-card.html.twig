{#
  Expects: item (Page), kind (string label override), meta (string override)
#}
{% set k = kind ?? (item.header.kind ?? 'Article') %}
{% set icon = {'Guide': '&#128218;', 'Glossary': '&#128209;', 'Article': '&#9997;&#65039;', 'News': '&#128240;'}[k] ?? '&#128196;' %}
<a class="kb-card" href="{{ item.url }}">
  <div class="kb-media"></div>
  <div class="kb-body">
    <div class="kb-icon">{{ icon|raw }}</div>
    <span class="kb-kind">{{ k }}</span>
    <h3>{{ item.title }}</h3>
    {% if item.header.tagline %}<p>{{ item.header.tagline }}</p>{% endif %}
    <span class="kb-meta">{{ meta ?? '' }}</span>
  </div>
</a>
