{% set p1 = page.parent %}
{% set p2 = p1 ? p1.parent : null %}
{% set p3 = p2 ? p2.parent : null %}
{% set crumbs = [{ name: 'Home', url: url('/', true) }] %}
{% if p3 and p3.route and p3.route != '/' %}{% set crumbs = crumbs|merge([{ name: p3.menu ?? p3.title, url: p3.url(true) }]) %}{% endif %}
{% if p2 and p2.route and p2.route != '/' %}{% set crumbs = crumbs|merge([{ name: p2.menu ?? p2.title, url: p2.url(true) }]) %}{% endif %}
{% if p1 and p1.route and p1.route != '/' %}{% set crumbs = crumbs|merge([{ name: p1.menu ?? p1.title, url: p1.url(true) }]) %}{% endif %}
{% if page.route != '/' %}{% set crumbs = crumbs|merge([{ name: page.menu ?? page.title, url: page.url(true) }]) %}{% endif %}

{% if crumbs|length > 1 %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="wrap">
    {% for c in crumbs %}
      {% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}
      {% if loop.last %}<span>{{ c.name }}</span>{% else %}<a href="{{ c.url }}">{{ c.name }}</a>{% endif %}
    {% endfor %}
  </div>
</nav>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for c in crumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ c.name|json_encode|raw }},"item":{{ c.url|json_encode|raw }}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
