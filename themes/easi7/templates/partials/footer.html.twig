<footer class="site">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href="{{ url('/') }}">EASI<em>7</em></a>
        <p style="margin-top:12px;font-size:0.9rem;">{{ config.themes.easi7.company.tagline }} &mdash; analytics, performance media, SEO, and automation, run as one system. Based in {{ config.themes.easi7.company.location }}.</p>
      </div>
      <div>
        <h4>Work</h4>
        <ul>
          <li><a href="{{ url('/services') }}">Services</a></li>
          <li><a href="{{ url('/portfolio') }}">Portfolio</a></li>
          <li><a href="{{ url('/case-studies') }}">Case Studies</a></li>
          <li><a href="{{ url('/clients') }}">Clients</a></li>
        </ul>
      </div>
      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href="{{ url('/knowledge-hub') }}">Knowledge Hub</a></li>
          <li><a href="{{ url('/blog') }}">Blog</a></li>
          <li><a href="{{ url('/tech-stack') }}">Tools We Use</a></li>
          <li><a href="{{ url('/about') }}">About</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:{{ config.themes.easi7.company.email }}">{{ config.themes.easi7.company.email }}</a></li>
          <li><a href="tel:{{ config.themes.easi7.company.phone_href }}">{{ config.themes.easi7.company.phone }}</a></li>
          <li>{{ config.themes.easi7.company.location }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {{ "now"|date('Y') }} {{ config.themes.easi7.company.legal_name }}. All rights reserved.</span>
      <div class="socials">
        {% for social in config.themes.easi7.socials %}
          <a href="{{ social.url }}" rel="noopener" target="_blank">{{ social.label }}</a>
        {% endfor %}
        <a href="{{ url('/privacy-policy') }}">Privacy</a>
        <a href="{{ url('/terms') }}">Terms</a>
      </div>
    </div>
  </div>
</footer>
