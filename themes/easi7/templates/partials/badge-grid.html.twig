{# Compact badge grid - upgrade over a plain wrapped tag row. Expects items: array of strings OR {label,url} objects #}
{% if items is defined and items|length %}
<div class="badge-grid">
  {% for item in items %}
    {% set label = item.label ?? item %}
    {% set link = item.url ?? null %}
    {% if link %}
    <a class="badge-item" href="{{ url(link) }}"><span class="badge-dot"></span>{{ label }}</a>
    {% else %}
    <span class="badge-item"><span class="badge-dot"></span>{{ label }}</span>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
