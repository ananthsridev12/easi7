{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">News</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.summary %}<p class="lede">{{ page.header.summary }}</p>{% endif %}
  </div>
</section>

<section class="block" style="border-bottom:none;">
  <div class="wrap with-sidebar">
    <div>
      <div class="blog-grid">
        {% for item in page.collection() %}
          {% set item_date = item.date ? item.date|date('M j, Y') : '' %}
          {% include 'partials/cards/kb-card.html.twig' with { item: item, kind: 'News', meta: item_date } %}
        {% endfor %}
      </div>
    </div>
    {% include 'partials/sidebar.html.twig' with {
      links_title: 'Explore',
      links: [
        { label: Blog, url: '/blog' },
        { label: 'Knowledge Hub', url: '/knowledge-hub' },
        { label: Services, url: '/services' },
        { label: 'Apps & Tools', url: '/apps' }
      ],
      recent_title: 'Recent Updates',
      recent: page.collection()|slice(0, 5),
      cta: {
        heading: 'Want updates like these in your inbox?',
        body: 'Get in touch and we can keep you posted directly.',
        button_label: 'Get in touch',
        button_url: '/contact'
      }
    } %}
  </div>
</section>
{% endblock %}
