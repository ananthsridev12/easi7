{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/breadcrumbs.html.twig' %}
<section class="page-hero">
  <div class="wrap">
    <div style="display:flex;gap:10px;align-items:center;margin-bottom:0.8em;flex-wrap:wrap;">
      {% for cat in page.taxonomy.category %}<span class="tag">{{ cat }}</span>{% endfor %}
    </div>
    <h1>{{ page.title }}</h1>
    <p class="mono" style="color:var(--ink-soft);font-size:0.85rem;">
      {{ page.date|date('F j, Y') }} &middot; {{ page.header.author ?? 'EASI7 Team' }}{% if page.header.read_time %} &middot; {{ page.header.read_time }}{% endif %}
    </p>
  </div>
</section>

<section class="block" style="border-bottom:none;">
  <div class="wrap with-sidebar">
    <div>
      {{ page.content|raw }}
    </div>
    {% include 'partials/sidebar.html.twig' with {
      links_title: 'Explore',
      links: [
        { label: 'All Articles', url: '/blog' },
        { label: 'Knowledge Hub', url: '/knowledge-hub' },
        { label: Services, url: '/services' },
        { label: 'Case Studies', url: '/case-studies' }
      ],
      recent_title: 'Recent Posts',
      recent: page.parent.collection()|slice(0, 5),
      cta: {
        heading: 'Have a project in mind?',
        body: "Tell us what's not working — we'll tell you honestly if we can help.",
        button_label: 'Start a conversation',
        button_url: '/contact'
      }
    } %}
  </div>
</section>

{% if page.header.cta %}
{% include 'partials/cta-band.html.twig' with page.header.cta %}
{% endif %}
{% endblock %}
